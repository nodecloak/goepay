<view class="page">
  <view class="card">
    <view class="heading">订单支付</view>
    <view class="caption">支付金额</view>
    <view class="amount"><text class="currency">¥</text>{{money || '--'}}</view>
    <view class="order"><text class="label">系统订单号</text><text class="number">{{tradeNo || '--'}}</text></view>
    <view class="message" aria-role="status">{{message}}</view>
    <button class="primary" bindtap="onPay" disabled="{{!canPay || busy}}" loading="{{busy}}">确认支付</button>
    <view class="hint">支付完成或取消后，请返回原订单页面查询结果。</view>
  </view>
</view>
