# Copy to .env and replace all credentials with cryptographically random values.
POSTGRES_PASSWORD=replace_with_random_local_password
GOEPAY_MASTER_KEY=replace_with_64_hex_characters
GOEPAY_SEED_PASSWORD=replace_with_random_password_at_least_12_chars
GOEPAY_SEED_API_KEY=replace_with_random_api_key_at_least_24_chars

# Optional explicit merchant IDs for loopback-only sandbox simulation.
# Ignored by configured providers. Empty retains the seeded merchant 1000 only.
# Comma-separated canonical positive IDs; no wildcard, spaces or duplicates.
GOEPAY_SIMULATION_MERCHANT_IDS=

# Explicit read-only Alipay preauthorization observation; configured HTTPS only.
GOEPAY_ENABLE_AUTHORIZATION_OBSERVATION=false

# Original barcode recovery is financial: it may cancel the original payment.
# Configured mode also requires explicit provider write/query opt-ins, an
# encrypted channel file and a merchant allowlist. Local simulation leaves it off.
GOEPAY_ENABLE_SCAN_RECOVERY=false

# Verification email submission is disabled unless explicitly configured.
# Strict authenticated TLS only: implicit (normally465) or starttls (normally587).
# SMTP acceptance does not guarantee inbox delivery. Never put real credentials
# in a committed file; these settings are not read from legacy imports.
GOEPAY_ENABLE_EMAIL_VERIFICATION=false
GOEPAY_ENABLE_SMTP_TEST=false
GOEPAY_ENABLE_ADMIN_CHANNEL_NOTICES=false
# Optional merchant message worker. Saving preferences does not enable delivery.
GOEPAY_ENABLE_MERCHANT_NOTICES=false
GOEPAY_ENABLE_ADMIN_BUSINESS_NOTICES=false
GOEPAY_MERCHANT_TELEGRAM_TOKEN=
GOEPAY_MERCHANT_WECHAT_APPID=
GOEPAY_MERCHANT_WECHAT_APPSECRET=
# Original voice endpoint was HTTP. Delivery requires an explicit HTTPS outlet.
GOEPAY_MERCHANT_VOICE_HTTPS_ENDPOINT=
GOEPAY_MERCHANT_VOICE_AGENT_ID=
GOEPAY_MERCHANT_VOICE_SECRET=
GOEPAY_ADMIN_NOTICE_RECIPIENT=
# Original sendAdminMessage fields mapped to protected worker configuration.
# Saved nonsecret console settings take precedence; these are process defaults.
# Webhook URLs, Bot credentials and SMTP secrets stay outside generic settings.
# risk: 0 mail, 1 robot, 2 Telegram, 3 QQ Bot. A missing selected target uses
# mail_recv, then mail_name, then the legacy notice recipient above.
# A selected invalid/failing transport never falls back to another sender.
GOEPAY_ADMIN_MSGCONFIG_RISK=0
GOEPAY_ADMIN_MSGROBOT_URL=
GOEPAY_ADMIN_MSGTELEGRAM_CHATID=
GOEPAY_ADMIN_LOGIN_TELEGRAM_TOKEN=
GOEPAY_ADMIN_QQBOT_APPID=
GOEPAY_ADMIN_QQBOT_APPSECRET=
GOEPAY_ADMIN_QQBOT_OPENID=
GOEPAY_ADMIN_MAIL_RECV=
GOEPAY_ADMIN_MAIL_NAME=
GOEPAY_SMTP_HOST=
GOEPAY_SMTP_PORT=
GOEPAY_SMTP_SECURITY=
GOEPAY_SMTP_USERNAME=
GOEPAY_SMTP_PASSWORD=
GOEPAY_SMTP_FROM=

# Dedicated local referral scheduler remains explicitly disabled by default.
GOEPAY_REFERRAL_SCHEDULER_ENABLED=false
GOEPAY_MERCHANT_NOTICE_SCHEDULER_ENABLED=false
GOEPAY_MERCHANT_NOTICE_SEND_HOUR=9

# Independent automatic wallet payouts remain off; the compose profile also
# hard-disables provider writes. A generation plan alone never sends money.
GOEPAY_SETTLEMENT_AUTO_ENABLED=false
GOEPAY_ENABLE_CHANNEL_AUTO_STOP=false

# Explicit collection-only source IDs, e.g. [1,2]. Empty/[] disables inheritance.
# Only merchants ABSENT from GOEPAY_MERCHANT_CHANNELS inherit; an explicit []
# entry still denies access. Groups can narrow/close these payment sources.
# This never grants transfers/automatic payouts; preauth needs explicit admission.
GOEPAY_DEFAULT_PAYMENT_CHANNELS=[]

# Optional offline system update trust. All four values are required together.
# Public key is an Ed25519 public key encoded as exactly 64 hexadecimal chars.
# Paths must be absolute local paths mounted into the API container. Keep the
# manifest/package read-only; staging is a separate private writable directory.
GOEPAY_UPDATE_MANIFEST_FILE=
GOEPAY_UPDATE_PACKAGE_FILE=
GOEPAY_UPDATE_STAGING_DIR=
GOEPAY_UPDATE_PUBLIC_KEY=
# Core-risk CLI/notice transports are independent and default off.
GOEPAY_ENABLE_CORE_RISK_CHECK=false
GOEPAY_ENABLE_CORE_RISK_NOTICES=false
# Local xdb files only; enabling geographic rules requires both families.
GOEPAY_RISK_GEO_IPV4_XDB=
GOEPAY_RISK_GEO_IPV6_XDB=
