flowchart LR
  subgraph S1["01 申请与预占"]
    direction TB
    A["满足权限、周期与金额规则"] --> B["核对收款资料和申请费用"]
    B --> C["保存申请，专用预占余额"]
  end
  subgraph S2["02 审核与执行"]
    direction TB
    D{"审核结果"}
    D -- "拒绝" --> E["记录拒绝并释放预占"]
    D -- "通过" --> F["固定原付款号与发送记录"]
    F --> G["按本次授权执行原付款"]
  end
  subgraph S3["03 结果收敛"]
    direction TB
    H{"原付款实际结果"}
    H -- "成功" --> I["结转净额与费用"]
    H -- "明确失败" --> J["记录失败，释放预占"]
    H -- "处理中 / 未知" --> K["保留预占，只查询原付款"]
    K --> H
  end
  S1 --> D
  G --> H
  I --> L["核对结算记录、资金明细与到账"]
