  "title": "商户开通流程",
  "subtitle": "平台先备齐业务规则，商户本人核对资料并完成接入验收",
  "stages": [
    {
      "title": "平台准备",
      "steps": [
        [
          "启用支付产品与通道"
        ],
        [
          "核对凭据、能力与状态"
        ],
        [
          "配置公共池",
          "或显式通道授权"
        ]
      ]
    },
    {
      "title": "商户开通",
      "steps": [
        [
          "设置用户组路由与费率"
        ],
        [
          "创建商户并指定分组"
        ],
        [
          "本人登录，核对商户号"
        ]
      ]
    },
    {
      "title": "准入核验",
      "decision": [
        "通道与费率",
        "符合预期？"
      ],
      "intro": "按要求认证、补足保证金",
      "branches": [
        {
          "when": "是",
          "lines": [
            "继续接入验收"
          ]
        },
        {
          "when": "否",
          "lines": [
            "调整分组或通道授权",
            "重新核对"
          ],
          "loop": true
        }
      ]
    },
    {
      "title": "接入验收",
      "steps": [
        [
          "本地模拟下单与回调"
        ],
        [
          "核对订单、入账",
          "及签名通知"
        ],
        [
          "资料确认后按范围启用"
        ]
      ]
    }
  ],
  "note": "商户接入前，应从本人后台确认实际可用通道、支付方式、费率与权限。"
}