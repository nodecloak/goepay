flowchart LR
  subgraph S1["01 形成事件"]
    direction TB
    A["可信业务事件发生"] --> B["持久保存事件 / 通知任务"]
    B --> C["按业务号关联原记录"]
  end
  subgraph S2["02 确定投递"]
    direction TB
    D["检查平台渠道与事件开关"] --> E["检查商户偏好及可信目标"]
    E --> F["确定本次账号、模板与收件人"]
  end
  subgraph S3["03 执行与留痕"]
    direction TB
    G["邮件 / 短信 / 机器人等投递"] --> H["记录每次执行与实际响应"]
    H --> I{"该渠道实际结果"}
    I -- "成功" --> J["完成原投递记录"]
    I -- "失败 / 未知" --> K["按渠道规则核对或重试"]
  end
  S1 --> S2 --> S3
  K --> L["语音、打印等外部效果未知时先核实"]
