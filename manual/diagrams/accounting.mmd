flowchart LR
  subgraph S1["01 收入确认"]
    direction TB
    A["可信支付结果"] --> B["按订单规则拆分收入与费用"]
    B --> C["复式记账 · 事件幂等"]
  end
  subgraph S2["02 资金占用"]
    direction TB
    D["商户可用余额"] --> E["退款或结算申请"]
    E --> F["原业务专用预占"]
  end
  subgraph S3["03 按真实结果入账"]
    direction TB
    G{"原业务结果"}
    G -- "确认成功" --> H["结转预占与原费用"]
    G -- "明确失败 / 审核拒绝" --> I["按规则释放至可用余额"]
    G -- "处理中 / 未知" --> J["保持预占，查询原业务"]
    J --> G
  end
  subgraph S4["04 核查依据"]
    direction TB
    K["业务号关联资金流水"] --> L["核对收入、费用与余额"]
    L --> M["审阅凭据与操作记录"]
  end
  S1 --> D
  F --> G
  H --> S4
  I --> S4
