flowchart LR
  subgraph S1["01 准备一致数据"]
    direction TB
    A["原站暂停写入"] --> B["取得一致 SQL 备份"]
    B --> C["全新目标上传备份"]
  end
  subgraph S2["02 预检查与确认"]
    direction TB
    D["检查数据范围、金额与状态"] --> E{"报告存在阻塞项？"}
    E -- "有" --> F["处理原业务后重新备份"]
    E -- "无" --> G["核对报告并确认原任务"]
  end
  subgraph S3["03 导入与核对"]
    direction TB
    H["事务导入核心业务数据"] --> I["加密归档与迁移记录"]
    I --> J["核对期初余额及导入数量"]
  end
  subgraph S4["04 验收与启用"]
    direction TB
    K["重配用户组、通道与登录资料"] --> L["模拟验收，逐个启用商户"]
    L --> M["运营方按计划安排切流"]
  end
  S1 --> D
  F -. "回到数据准备" .-> S1
  G --> S3 --> S4
