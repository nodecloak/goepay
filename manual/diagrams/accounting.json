  "stages": [
    {
      "title": "确认收入",
      "steps": [
        [
          "收到可信支付结果"
        ],
        [
          "按订单规则拆分",
          "商户收入与平台费用"
        ],
        [
          "复式记账",
          "重复事件不重复入账"
        ]
      ]
    },
    {
      "title": "预占资金",
      "steps": [
        [
          "商户可用余额"
        ],
        [
          "发起退款或结算申请"
        ],
        [
          "关联原业务",
          "转入专用预占"
        ]
      ]
    },
    {
      "title": "确认原业务结果",
      "decision": [
        "原业务实际结果"
      ],
      "branches": [
        {
          "when": "确认成功",
          "lines": [
            "结转预占与原费用"
          ]
        },
        {
          "when": "失败 / 审核拒绝",
          "lines": [
            "按规则释放",
            "至可用余额"
          ]
