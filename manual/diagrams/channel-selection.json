{
  "kind": "workflow",
  "description": "授权来源、用户组路由与实时准入共同决定本次收款通道",
  "title": "收款通道选择流程",
  "subtitle": "授权来源、用户组路由与实时准入共同决定本次收款通道",
  "stages": [
    {
      "title": "确定授权来源",
      "decision": [
        "存在商户",
        "显式通道授权？"
      ],
      "branches": [
        {
          "when": "有",
          "lines": [
            "使用显式授权集合"
          ]
        },
        {
          "when": "无",
          "lines": [
            "读取公共默认收款池"
          ]
        }
      ]
    },
    {
      "title": "应用路由规则",
      "steps": [
        [
          "读取当前有效用户组"
        ],
        [
          "应用支付方式路由"
        ],
        [
          "按规则轮询候选通道"
        ]
      ]
    },
    {
      "title": "执行准入检查",
      "steps": [
        [
          "商户与通道状态",
          "支付方式及金额限额"
        ],
        [
          "风控规则与业务权限"
        ],
        [
          "实名认证与保证金条件"
        ]
      ]
    },
    {
      "title": "保存选择结果",
      "decision": [
        "存在满足条件",
        "的可用通道？"
      ],
      "branches": [
        {
          "when": "是",
          "lines": [
            "保存实际通道与规则",
            "生成原订单支付材料"
          ]
        },
        {
          "when": "否",
          "lines": [
            "拒绝新收款",
            "返回具体原因"
          ]
        }
      ]
    }
  ],
  "note": "授权来源为空或无可用候选时，新收款会被拒绝；已有订单继续依据原订单资料处理。"
}