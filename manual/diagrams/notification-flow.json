      "title": "形成事件",
      "steps": [
        [
          "可信业务事件发生"
        ],
        [
          "持久保存事件",
          "或原通知任务"
        ],
        [
          "按业务号关联原记录"
        ]
      ]
    },
    {
      "title": "确定投递",
      "steps": [
        [
          "检查平台渠道",
          "与事件开关"
        ],
        [
          "检查商户偏好",
          "及可信接收目标"
        ],
        [
          "确定本次账号",
          "模板与收件人"
        ]
      ]
    },
    {
      "title": "执行与留痕",
      "steps": [
        [
          "邮件、短信、机器人",
          "语音或打印等投递"
        ],
        [
          "保存每次执行",
          "及实际响应"
        ],
        [
          "查看同一投递记录"
        ]
      ]
    },
    {
      "title": "核对实际结果",
      "decision": [
        "该渠道实际结果"
      ],
      "branches": [
        {
          "when": "成功",
          "lines": [
            "完成原投递记录"
          ]
        },
        {
          "when": "明确失败",
          "lines": [
            "按渠道规则处理重试"
          ]
        },
        {
          "when": "外部效果未知",
          "lines": [
            "先核实实际状态",
            "再决定后续处理"
          ]
        }
      ]
